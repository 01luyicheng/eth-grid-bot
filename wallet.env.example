# ==========================================
# ETH Grid Bot — 配置示例
# 复制此文件为 wallet.env 并填写你的值
# ==========================================

# ⚠️ 私钥（不带 0x 前缀，40个十六进制字符）
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
# WALLET_ADDRESS 会自动从私钥派生，留空或填入也可以
WALLET_ADDRESS=

# ==========================================
# 网络配置
# ==========================================
BASE_RPC=https://mainnet.base.org
CHAIN_ID=8453
# HTTP 代理（可选，用于绕过网络限制）
PROXY_HTTP=http://127.0.0.1:10808

# ==========================================
# 网格交易参数
# ==========================================
GRID_CENTER=auto                    # auto = 启动时获取实时价格；或固定数字如 2000
GRID_RANGE_PCT=10                   # 网格覆盖的价格范围（上下各 RANGE_PCT%）
GRID_TIERS=5                        # 网格档位数（买卖各 GRID_TIERS-1 层）

# 每次交易量（ETH）
SWAP_AMOUNT_WETH=0.0002

# 止损（网格下沿基础上再跌 STOP_LOSS_BUFFER_PCT% 触发）
STOP_LOSS_BUFFER_PCT=5

# 交易冷却时间（秒），防止同一档位重复触发
TRADE_COOLDOWN=120

# 价格检查间隔（秒）
CHECK_INTERVAL=10

# ==========================================
# 滑点保护（支持三种写法）
# SLIPPAGE=0.5   → 0.5%（小数形式）
# SLIPPAGE=5     → 5%（整数形式）
# SLIPPAGE=0.005 → 0.5%（直接小数）
# ==========================================
SLIPPAGE=0.5

# ==========================================
# 跟踪止盈（可选）
# ==========================================
# 价格突破此阈值后，开启 3% 跟踪止盈
TRAIL_TRIGGER_PRICE=1900

# ==========================================
# 安全参数
# ==========================================
# ETH 最低余额（低于此值不执行卖出，防止 gas 耗尽）
MIN_BALANCE_ETH=0.001
